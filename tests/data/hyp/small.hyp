{VERSION=2.14}
{UNITS=ENGLISH LENGTH}

Written by hand in the form KiCad 10's HyperLynx export writes, with one of each thing
the reader handles. Text outside a record, like this, is a comment.

{BOARD "C:/boards/small/small.kicad_pcb"
  (PERIMETER_SEGMENT X1=0.000000000 Y1=0.000000000 X2=2.000000000 Y2=0.000000000)
  (PERIMETER_SEGMENT X1=2.000000000 Y1=0.000000000 X2=2.000000000 Y2=-1.000000000)
  (PERIMETER_ARC X1=0.000000000 Y1=-1.000000000 X2=2.000000000 Y2=-1.000000000 XC=1.000000000 YC=-1.000000000 R=1.000000000)
  (PERIMETER_SEGMENT X1=0.000000000 Y1=-1.000000000 X2=0.000000000 Y2=0.000000000)
  (PERIMETER_SEGMENT X1=0.200000000 Y1=-0.200000000 X2=0.400000000 Y2=-0.200000000)
  (PERIMETER_SEGMENT X1=0.400000000 Y1=-0.200000000 X2=0.400000000 Y2=-0.400000000)
  (PERIMETER_SEGMENT X1=0.400000000 Y1=-0.400000000 X2=0.200000000 Y2=-0.400000000)
  (PERIMETER_SEGMENT X1=0.200000000 Y1=-0.400000000 X2=0.200000000 Y2=-0.200000000)
}

{STACKUP
  (DIELECTRIC T=0.000393701 C=3.3 L="F.Mask" M="Solder Mask")
  (SIGNAL T=0.00137795 P=0 C=1.724e-08 L="F.Cu" M=COPPER) top copper
  (DIELECTRIC T=0.00393701 C=4.1 L="DE_F.Cu" M="Prepreg")
  (PLANE T=0.000688976 P=0 C=1.724e-08 L="GND_PLANE" M=COPPER)
  (DIELECTRIC T=0.0472441 C=4.6 L="DE_GND_PLANE" M="FR4 core")
  (SIGNAL T=0.000688976 P=0 C=1.724e-08 L="In2.Cu" M=COPPER)
  (DIELECTRIC T=0.00393701 C=4.1 L="DE_In2.Cu" M="Prepreg")
  (SIGNAL T=0.00137795 P=0 C=1.724e-08 L="B.Cu" M=COPPER)
  (DIELECTRIC T=0.000393701 C=3.3 L="B.Mask" M="Solder Mask")
}

{DEVICES
  (? REF="R1" L="F.Cu")
  (C REF="C1" NAME="C1" VAL="100n" PKG="C_0402" L="B.Cu")
  (? REF="U1" L="F.Cu")
  (? REF="J1" L="F.Cu")
  (? REF="MH1" L="F.Cu")
  (? REF="LOGO1" L="F.Cu")
}

{PADSTACK=0, 0.000000000
  ("F.Cu", 1, 0.040000000, 0.020000000, 90.0, M)
}

{PADSTACK=1, 0.000000000
  ("B.Cu", 2, 0.040000000, 0.020000000, 180.0, M)
}

{PADSTACK=2, 0.040000000
  ("MDEF", 0, 0.070000000, 0.070000000, 0.0, M)
  ("MDEF", 0, 0.090000000, 0.090000000, 0.0, A)
}

{PADSTACK=3, 0.012000000
  ("MDEF", 0, 0.024000000, 0.024000000, 0.0, M)
}

{PADSTACK="BLIND", 0.008000000
  ("F.Cu", 0, 0.016000000, 0.016000000, 0.0, M)
  ("GND_PLANE", 0, 0.018000000, 0.018000000, 0.0, M)
}

{PADSTACK=5, 0.000000000
  ("F.Cu", 0, 0.060000000, 0.020000000, 0.0, M)
}

{PADSTACK=6, 0.125000000
}

{NET="+5V"
  (PIN X=0.5000000000 Y=-0.5000000000 R="R1.1" P=0)
  (PIN X=1.0000000000 Y=-0.5000000000 R="J1.1" P=2)
  (SEG X1=0.5000000000 Y1=-0.5000000000 X2=1.0000000000 Y2=-0.5000000000 W=0.0100000000 L="F.Cu")
  (ARC X1=1.0000000000 Y1=-0.5000000000 X2=1.2000000000 Y2=-0.3000000000 XC=1.2000000000 YC=-0.5000000000 R=0.2000000000 W=0.0100000000 L="In2.Cu")
  (VIA X=1.5000000000 Y=-0.5000000000 P=3)
  (VIA X=1.6000000000 Y=-0.5000000000 P="BLIND")
  {POLYGON T=POUR L="F.Cu" ID=7 X=1.0000000000 Y=-0.1000000000
    (LINE X=1.4000000000 Y=-0.1000000000)
    (LINE X=1.4000000000 Y=-0.3000000000)
    (CURVE X1=1.0000000000 Y1=-0.3000000000 X2=1.4000000000 Y2=-0.3000000000 XC=1.2000000000 YC=-0.3000000000 R=0.2000000000)
    (LINE X=1.0000000000 Y=-0.1000000000)
  }
  {POLYVOID ID=7 X=1.1000000000 Y=-0.1500000000
    (LINE X=1.3000000000 Y=-0.1500000000)
    (LINE X=1.3000000000 Y=-0.2500000000)
    (LINE X=1.1000000000 Y=-0.2500000000)
    (LINE X=1.1000000000 Y=-0.1500000000)
  }
  {POLYLINE T=POUR L="B.Cu" W=0.0200000000 ID=8 X=0.2000000000 Y=-0.8000000000
    (LINE X=0.8000000000 Y=-0.8000000000)
  }
}

{NET="GND"
  (PIN X=1.8000000000 Y=-0.8000000000 R="U1.2" P=99)
  {POLYGON T=PLANE L="GND_PLANE" ID=9 X=0.1000000000 Y=-0.1000000000
    (LINE X=1.9000000000 Y=-0.1000000000)
    (LINE X=1.9000000000 Y=-0.9000000000)
    (LINE X=0.1000000000 Y=-0.9000000000)
    (LINE X=0.1000000000 Y=-0.1000000000)
  }
  {POLYGON T=COPPER L="B.Cu" ID=10 X=1.5000000000 Y=-0.7000000000
    (LINE X=1.7000000000 Y=-0.7000000000)
    (LINE X=1.7000000000 Y=-0.9000000000)
    (LINE X=1.5000000000 Y=-0.9000000000)
    (LINE X=1.5000000000 Y=-0.7000000000)
  }
}

{NET="Net-(U1-Pad1)"
  (PIN X=0.8000000000 Y=-0.7000000000 R="U1.1" P=5)
}

{NET="SIG"
  (PIN X=0.6000000000 Y=-0.5000000000 R="R1.2" P=0)
  (PIN X=0.5000000000 Y=-0.9000000000 R="C1.1" P=1)
  (PIN X=0.5400000000 Y=-0.9000000000 R="C1.2" P=1)
}

{NET="EmptyNet0"
  (PIN X=1.8000000000 Y=-0.2000000000 R="MH1.1" P=6)
}

{END}
